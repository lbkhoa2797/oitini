# Copy to .env and fill in your keys.

# Required 
ANTHROPIC_API_KEY=sk-ant-...
# Materials Project API key (simulator node / query_materials_project tool)
MP_API_KEY=

# Contact email included in the User-Agent for polite arXiv/API usage (optional)
CONTACT_EMAIL="you@example.com"

# DFT toolchain (required to run the simulator; absolute paths)
# These are machine-specific
# config.py. `python -c "from tools.dft import preflight_dft; preflight_dft()"`
# checks them and names whichever one is wrong.

# directory containing pw.x
QE_BIN=/path/to/qe/bin
# Location of the pseudo pot. files named <Symbol>.upf, e.g. Zn.upf
QE_PSEUDOS_DIR=/path/to/pseudo/dir
# only needed for the Wannier90 tools
W90_DIR=/path/to/wannier90/bin
# only needed for the Perturbo tools
PERTURBO_BIN=/path/to/perturbo/bin 

# LangSmith tracing (optional; leave ALL unset to disable)
LANGSMITH_TRACING=                 # Setting to true enables LangSmith tracing
LANGSMITH_API_KEY=                 # API key obtained from LangSmith
LANGSMITH_PROJECT=                 # The name of your project

# EU data region only (default endpoint is US):
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
