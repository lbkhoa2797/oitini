# Copy to .env and fill in your keys.

# Required 
ANTHROPIC_API_KEY=sk-ant-...
# Materials Project API key (simulator node / query_materials_project tool)
MP_API_KEY=

# Contact email included in the User-Agent for polite arXiv/API usage (optional)
CONTACT_EMAIL=you@example.com

# LangSmith tracing (optional; leave ALL unset to disable)
LANGSMITH_TRACING=                 # Set to true to enable LangSmith tracing
LANGSMITH_API_KEY=                 # API key obtained from LangSmith
LANGSMITH_PROJECT=                 # Set the name of your project

# EU data region only (default endpoint is US):
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
